{
  "name": "@tapsmith/core-linux-arm64",
  "version": "0.5.0",
  "description": "Tapsmith daemon binary for Linux ARM64",
  "os": ["linux"],
  "cpu": ["arm64"],
  "files": ["tapsmith-core"],
  "preferUnplugged": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tapsmith/tapsmith.git",
    "directory": "npm-packages/core-linux-arm64"
  },
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node -e \"try{require('fs').chmodSync('tapsmith-core',0o755)}catch(e){console.warn('tapsmith: chmod failed:',e.message)}\""
  }
}
