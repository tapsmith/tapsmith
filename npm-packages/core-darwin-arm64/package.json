{
  "name": "@tapsmith/core-darwin-arm64",
  "version": "0.5.0",
  "description": "Tapsmith daemon binary for macOS ARM64",
  "os": ["darwin"],
  "cpu": ["arm64"],
  "files": ["tapsmith-core", "tapsmith-ios-hid"],
  "preferUnplugged": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tapsmith/tapsmith.git",
    "directory": "npm-packages/core-darwin-arm64"
  },
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node -e \"for(const f of ['tapsmith-core','tapsmith-ios-hid']){try{require('fs').chmodSync(f,0o755)}catch(e){console.warn('tapsmith: chmod '+f+' failed:',e.message)}}\""
  }
}
