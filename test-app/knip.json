{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.tsx"
  ],
  "project": [
    "app/**/*.tsx",
    "components/**/*.tsx"
  ],
  "ignoreDependencies": [
    "@expo/vector-icons",
    "expo-status-bar",
    "expo-updates",
    "expo-system-ui",
    "expo-router",
    "@tapsmith/react-native"
  ],
  "ignoreExportsUsedInFile": true
}
