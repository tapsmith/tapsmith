---
import '../styles/global.css'
import { existsSync, readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { Code } from 'astro:components'
import type { ComponentProps } from 'astro/types'

// Every code block on the page is highlighted at build time by Astro's <Code>
// (Shiki) with this small theme drawn from the site palette, so the hero, the
// API tabs and the one-liners all read the same. Backgrounds come from the
// surrounding cards, not the theme.
type CodeTheme = NonNullable<ComponentProps<typeof Code>['theme']>
const codeTheme: CodeTheme = {
  name: 'tapsmith',
  type: 'dark',
  colors: { 'editor.background': '#00000000', 'editor.foreground': '#d4cfc8' },
  tokenColors: [
    {
      scope: ['comment', 'punctuation.definition.comment'],
      settings: { foreground: '#7a7570', fontStyle: 'italic' },
    },
    { scope: ['string', 'punctuation.definition.string'], settings: { foreground: '#e8a86c' } },
    {
      scope: [
        'keyword',
        'storage.type',
        'storage.modifier',
        'keyword.control',
        'keyword.operator.expression',
        'keyword.operator.new',
      ],
      settings: { foreground: '#e8914b' },
    },
    {
      scope: ['entity.name.function', 'support.function', 'entity.name.command'],
      settings: { foreground: '#9fc1e0' },
    },
    {
      scope: [
        'meta.object-literal.key',
        'variable.other.property',
        'support.variable.property',
        'support.type.property-name',
      ],
      settings: { foreground: '#cfc3ad' },
    },
    {
      scope: ['constant.numeric', 'constant.language', 'support.constant'],
      settings: { foreground: '#d9a066' },
    },
    {
      scope: [
        'variable.parameter',
        'variable.other.readwrite',
        'variable.other.object',
        'variable.other.constant',
      ],
      settings: { foreground: '#d4cfc8' },
    },
    {
      scope: ['punctuation', 'meta.brace', 'keyword.operator', 'storage.type.function.arrow'],
      settings: { foreground: '#a39d95' },
    },
    {
      scope: ['keyword.operator.arrow', 'storage.type.function.arrow'],
      settings: { foreground: '#e8914b' },
    },
  ],
}

const codeSnippet = `import { test, expect } from "tapsmith"

test("user can check out", async ({ device }) => {
  // Mock the payment API: no mock server, no special build
  await device.route("**/api/payment", (route) =>
    route.fulfill({ json: { status: "success" } }),
  )

  await device.getByRole("button", { name: "Add to cart" }).tap()
  await device.getByText("Checkout").tap()

  await expect(device.getByText("Order confirmed")).toBeVisible()
})`

// Cache-busting version for the demo video, written by scripts/sync-promo.mjs
// at build time from the fetched file's hash. Read with fs (not an import) so
// `astro check` works on a checkout that has not run the sync.
// astro build runs with the website directory as cwd (npm run build)
const promoVersionFile = resolve(process.cwd(), 'src', 'promo-version.json')
const promoVersion: string | null = existsSync(promoVersionFile)
  ? (JSON.parse(readFileSync(promoVersionFile, 'utf8')).v ?? null)
  : null
const promoSrc = promoVersion ? `/promo.mp4?v=${promoVersion}` : '/promo.mp4'

// GitHub mark (octicon), used inline next to the GitHub links
const githubMark =
  '<svg class="tp-gh-mark" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>'

const snippets = {
  locators: `// Same readable API across platforms
await device.getByRole("button", { name: "Sign in" }).tap()
await device.getByLabel("Email").type("alex@tapsmith.dev")
await device.getByText("Forgot password?").tap()`,
  network: `// Mock any HTTP/HTTPS call. The proxy starts on the first route()
await device.route("**/api/feed", route =>
  route.fulfill({ json: fixtures.emptyFeed })
)
await device.route("**/payment", route => route.abort())`,
  gestures: `// Precise gesture control
await device.swipe("left")
await device.getByRole("image").pinchOut({ scale: 2 })
await device.getByLabel("Reorder").dragTo(device.getByText("Pinned"))`,
}

const comparisonRows = [
  ['Playwright-style TypeScript API', 'Y', 'N', 'N', 'P'],
  ['Reusable helpers, loops & fixtures', 'Y', 'Y', 'P', 'Y'],
  ['iOS + Android single suite', 'Y', 'Y', 'Y', 'Y'],
  // Appium: a server plus a driver per platform, each on its own release
  // train, plus capabilities to keep in step with Xcode / Android. Maestro's
  // single CLI install is genuinely easy. Detox needs native project
  // integration, applesimutils and a Jest/runner config per app.
  ['One npm install, no server or drivers', 'Y', 'N', 'Y', 'P'],
  ['Auto-waiting on every action', 'Y', 'N', 'Y', 'Y'],
  ['Rich assertions with auto-retry', 'Y', 'N', 'P', 'P'],
  ['Network mocking in the test API (no mock server)', 'Y', 'P', 'N', 'N'],
  // Appium: file push/pull primitives exist, but no container snapshot, no
  // Keystore-preserving restore and no runner integration. Maestro and Detox
  // only clear state (clearState / launchApp({ delete }), resetAppState).
  ['Save & restore app state (log in once)', 'Y', 'P', 'N', 'N'],
  ['Trace viewer', 'Y', 'N', 'N', 'P'],
  ['CI sharding with merged reports', 'Y', 'N', 'P', 'P'],
  // Appium: two driver sessions in one test is a documented pattern, but the
  // test orchestrates them itself and nothing joins the two devices' traces.
  // Maestro (issue #2957) and Detox (issue #393) have no way to drive two
  // devices from one flow/test.
  ['Multi-device tests (two devices, one test)', 'Y', 'P', 'N', 'N'],
  ['Interactive UI mode', 'Y', 'N', 'Y', 'N'],
  ['MCP for AI agents (locators, traces)', 'Y', 'P', 'P', 'N'],
]

const threeThings = [
  {
    n: '1',
    title: 'Mock the network without a mock server.',
    body: 'In every other framework, mocking an API means a separate mock server, a proxy with certificate fiddling, or a special build of your app. In Tapsmith it’s <code>device.route("**/api/payment", r => r.fulfill({ json }))</code>. One line, inline, done, on a proxy Tapsmith starts for you the moment a test mocks.',
  },
  {
    n: '2',
    title: 'A real language, not a YAML ceiling.',
    body: 'Maestro flows are brilliantly simple, right up until the suite grows and logic ends up scattered across YAML, env-var parameters, and <code>runScript</code> snippets. Tapsmith tests are plain TypeScript: extract helpers, loop over fixtures, share setup between tests, and refactor with autocomplete and type-checking behind you.',
  },
  {
    n: '3',
    title: 'Replay the failure, don’t reconstruct it.',
    body: 'Turn tracing on and every test records a trace: every tap, every network call, every frame. When a test fails at 3 am, open the trace viewer and scrub through it like a video instead of staring at a stack trace.',
  },
  {
    n: '4',
    title: 'Set up in minutes, not sprints.',
    body: 'Appium means a server, a driver per platform, a capabilities blob, and keeping all three in step with every Xcode and Android release. Tapsmith is one npm package: the daemon, the device agents and the trace viewer come with it, <code>tapsmith init</code> writes your config, and <code>tapsmith doctor</code> tells you what’s missing. No server to start, no drivers to update.',
  },
]

// The manifesto lights up word by word as it scrolls
const manifesto =
  'Tapsmith takes the parts of Playwright that engineers love, the locators, the auto-waiting, the trace viewer, and rebuilds them for real devices.'.split(
    ' ',
  )

const tools = [
  {
    id: 'trace',
    label: 'Trace viewer',
    img: '/trace-viewer.png',
    alt: 'Tapsmith trace viewer showing a failed login test: timeline of screenshots, action log with the failed assertion, the app’s error state, and the error with a source snippet',
    body: 'With tracing on, every test records a full trace. Scrub through a timeline of screenshots, see every tap and gesture overlaid on the screen, and inspect every network request and response. When a test fails in CI, download the trace and replay it locally.',
    cmd: 'npx tapsmith show-trace trace.zip',
    href: '/guides/trace-viewer/',
  },
  {
    id: 'ui',
    label: 'UI mode',
    img: '/ui-mode.png',
    alt: 'Tapsmith UI mode running a network-mocking test across Android and iOS, with the test tree, trace actions, mocked network response, and live device mirrors',
    body: 'A browser-based interactive runner. Click any test to run it, see results stream in live, browse traces and screenshots inline, and mirror the device screen, all without leaving the browser.',
    cmd: 'npx tapsmith test --ui',
    href: '/guides/ui-mode/',
  },
  {
    id: 'pick',
    label: 'Locator picker',
    img: '/ui-mode-pick-locator.png',
    alt: 'Pick mode in the live device mirror: the picked element is highlighted on the device and the Locator tab lists suggested locators with match counts',
    body: 'Click an element on the mirrored device and UI mode suggests locators for it, each one checked against the device so only those that find exactly that element are listed. Edit the locator and the match count updates against the real app.',
    cmd: 'npx tapsmith test --ui',
    href: '/guides/ui-mode/#picking-locators-from-the-mirror',
  },
  {
    id: 'report',
    label: 'HTML report',
    img: '/html-report.png',
    alt: 'HTML report with a pass/fail summary, filter chips, and per-test rows including trace and video links for a failed test',
    body: 'A self-contained page with a pass/fail summary, filtering and per-test durations, with links to each failure’s trace and video. Sharded CI runs merge into one report.',
    cmd: 'npx tapsmith show-report',
    href: '/reference/api/reporters/',
  },
]

const faqs = [
  {
    q: 'Is Tapsmith free?',
    a: 'Yes. Tapsmith is open source under the Apache-2.0 licence. It runs on your machine and in your CI, against your own emulators, simulators and devices.',
  },
  {
    q: 'Which apps can it test?',
    a: 'iOS and Android apps, whether they are built natively or with React Native, Expo or Flutter. One test file runs on both platforms, on Android emulators and devices (Android 8.0+), iOS simulators (iOS 17+) and <a href="/platform/ios-physical-devices/">physical iPhones</a>.',
  },
  {
    q: 'Do I need to know Playwright?',
    a: 'No, but if you do, you already know most of Tapsmith: <code>test</code>, <code>describe</code>, <code>expect</code>, hooks, fixtures, <code>test.extend()</code>, projects, <code>--ui</code> and <code>--trace</code> all work the way you expect.',
  },
  {
    q: 'How do I move from the tool I use today?',
    a: 'There is a migration guide for each of the usual starting points. Each one maps your current tool onto Tapsmith and ports a test side by side: <a href="/guides/migrating-from-maestro/">from Maestro</a>, <a href="/guides/migrating-from-detox/">from Detox</a> and <a href="/guides/migrating-from-appium/">from Appium</a>.',
  },
  {
    q: 'Does it work with AI coding agents?',
    a: 'Yes. The <a href="/guides/mcp-server/">MCP server</a> lets an agent drive a device, test locators, run tests and read traces, and the docs ship inside the npm package so an agent can read them offline. See <a href="/guides/agents/">Using Tapsmith with AI coding agents</a>.',
  },
  {
    q: 'Does it run in CI?',
    a: 'Yes. Tapsmith boots the emulators and simulators it needs, runs workers in parallel, and shards across machines with one merged report at the end. The <a href="/platform/ci-setup/">CI setup guide</a> has working pipelines.',
  },
]

const marks: Record<string, string> = { Y: '✓', P: '◐', N: '—' }
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tapsmith: Playwright-style testing for native mobile apps</title>
    <meta
      name="description"
      content="A test framework for native iOS and Android. Same locators, same auto-waiting, same trace viewer as Playwright, rebuilt for real devices."
    />
    <!-- Link previews (WhatsApp, Slack, X, LinkedIn…). Starlight emits these for
         docs pages, but this page has its own <head>. Image URLs must be absolute. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tapsmith.dev/" />
    <meta property="og:site_name" content="Tapsmith" />
    <meta property="og:title" content="Tapsmith: Playwright-style testing for native mobile apps" />
    <meta
      property="og:description"
      content="A test framework for native iOS and Android. Same locators, same auto-waiting, same trace viewer as Playwright, rebuilt for real devices."
    />
    <meta property="og:image" content="https://tapsmith.dev/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tapsmith: the web testing experience, on mobile" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://tapsmith.dev/og-image.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(function () {
        var stored = localStorage.getItem('starlight-theme')
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        var theme = stored === 'dark' || (!stored && prefersDark) ? 'dark' : 'light'
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <!-- 1. Sticky header -->
    <header class="tp-header">
      <div class="tp-container tp-header-inner">
        <a href="/" class="tp-logo">
          <img src="/logo.png" alt="Tapsmith" class="tp-logo-img tp-logo-light" />
          <img src="/logo-dark.png" alt="Tapsmith" class="tp-logo-img tp-logo-dark" />
        </a>
        <nav class="tp-nav" id="tp-nav">
          <a href="/getting-started/">Docs</a>
          <a href="/reference/api/locators/">API</a>
          <a href="/guides/network/">Guides</a>
          <a
            href="https://github.com/tapsmith/tapsmith"
            target="_blank"
            rel="noopener"
            class="tp-link-icon"><Fragment set:html={githubMark} />GitHub</a
          >
        </nav>
        <div class="tp-header-actions">
          <button class="tp-theme-toggle" type="button" aria-label="Toggle theme">
            <svg
              class="tp-icon-sun"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"
              ></line><line x1="12" y1="21" x2="12" y2="23"></line><line
                x1="4.22"
                y1="4.22"
                x2="5.64"
                y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line
                x1="1"
                y1="12"
                x2="3"
                y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line
                x1="4.22"
                y1="19.78"
                x2="5.64"
                y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg
            >
            <svg
              class="tp-icon-moon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
            >
          </button>
          <a href="/getting-started/" class="tp-btn-solid tp-btn-sm">Get started →</a>
          <button
            class="tp-nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="tp-nav"
          >
            <svg
              class="tp-icon-menu"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"
              ></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
            >
            <svg
              class="tp-icon-close"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
              ></line></svg
            >
          </button>
        </div>
      </div>
    </header>

    <main>
      <!-- 2. Hero: the forge. A touch grid where every tap lands like a hammer strike -->
      <section class="tp-hero" data-forge-zone>
        <canvas class="tp-forge" aria-hidden="true"></canvas>
        <div class="tp-container tp-hero-inner">
          <h1 class="tp-hero-h1">
            <span class="tp-h1-line">Mobile tests that <span class="tp-muted">feel</span></span>
            <span class="tp-h1-line tp-h1-indent"
              ><span class="tp-muted">like</span> web tests.</span
            >
          </h1>
          <div class="tp-hero-foot">
            <p class="tp-hero-lead">
              A test framework for iOS and Android apps, built natively or with React Native, Expo
              or Flutter. If you know Playwright, you already know most of it.
            </p>
            <div class="tp-hero-ctas">
              <a href="/getting-started/" class="tp-btn-solid">Get started →</a>
              <button
                type="button"
                class="tp-copy"
                data-copy="npm i -D tapsmith"
                aria-label="Copy install command: npm i -D tapsmith"
              >
                <span class="tp-copy-dollar">$</span>
                <span class="tp-copy-cmd">npm i -D tapsmith</span>
                <span class="tp-copy-state" aria-hidden="true">copy</span>
              </button>
              <span class="tp-hero-req">Open source, Apache-2.0 · Requires Node.js 22+</span>
            </div>
          </div>
        </div>
        <p class="tp-forge-hint" aria-hidden="true">tap anywhere</p>
      </section>

      <!-- 3. Manifesto -->
      <section class="tp-manifesto">
        <div class="tp-container">
          <p class="tp-manifesto-text">
            {
              manifesto.map((word) => (
                <Fragment>
                  <span class="tp-w">{word}</span>{' '}
                </Fragment>
              ))
            }
          </p>
        </div>
      </section>

      <!-- 4. Live demo: the test, the device and the terminal, in step -->
      <section class="tp-run" id="how-it-runs">
        <div class="tp-container">
          <div class="tp-section-head">
            <h2 class="tp-h2">Watch a test run on a device.</h2>
            <p class="tp-section-lead">
              Tapsmith lives in your repo and runs from your terminal and your CI. Each action waits
              for its element to be visible, enabled and stable, and each assertion retries until it
              passes. You never write a sleep.
            </p>
          </div>

          <div class="tp-stage" data-demo>
            <div class="tp-ide">
              <div class="tp-code-chrome">
                <span class="tp-code-filename">tests/checkout.tapsmith.ts</span>
                <span class="tp-code-status" data-demo-status>
                  <span class="tp-dot-status"></span>
                  <span data-demo-status-text>passed · 1.4s</span>
                </span>
              </div>
              <div class="tp-demo-code">
                <Code code={codeSnippet} lang="ts" theme={codeTheme} />
              </div>
              <div class="tp-term">
                <div class="tp-term-bar">
                  <span class="tp-term-tab">zsh</span>
                  <button type="button" class="tp-term-replay" data-demo-replay>↻ replay</button>
                </div>
                <pre
                  class="tp-term-body"><span class="tp-term-line" data-term="cmd"><span class="tp-term-prompt">$</span> <span data-term-typed>npx tapsmith test</span><span class="tp-term-caret" /></span>
<span class="tp-term-line" data-term="start">
Running tests from 1 file(s)
</span>
<span class="tp-term-line" data-term="pass">  <span class="tp-term-ok">✓</span> <span class="tp-term-dim">[1] › tests/checkout.tapsmith.ts ›</span> user can check out <span class="tp-term-dim">(1.4s)</span></span>
<span class="tp-term-line" data-term="summary">
<b>Summary:</b> <span class="tp-term-ok">1 passed</span> <span class="tp-term-dim">| 1.4s</span></span></pre>
              </div>
            </div>

            <div class="tp-device">
              <div
                class="tp-phone"
                data-step="5"
                role="img"
                aria-label="A phone running the app under test: Tapsmith taps Add to cart, taps Checkout, and the app shows Order confirmed"
              >
                <div class="tp-phone-screen">
                  <div class="tp-phone-status">
                    <span>9:41</span>
                    <span class="tp-phone-island"></span>
                    <span class="tp-phone-batt"></span>
                  </div>

                  <div class="tp-app tp-app-product">
                    <div class="tp-app-bar">
                      <span class="tp-app-back">‹</span>
                      <span>Shop</span>
                      <span class="tp-app-cart">
                        <svg
                          width="16"
                          height="16"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          ><circle cx="9" cy="20" r="1.4"></circle><circle cx="18" cy="20" r="1.4"
                          ></circle><path d="M2 3h3l2.6 12.4h11.2L21 7H6.2"></path></svg
                        >
                        <i class="tp-app-badge">1</i>
                      </span>
                    </div>
                    <div class="tp-app-photo">
                      <svg viewBox="0 0 120 120" width="156" height="156" aria-hidden="true">
                        <path d="M32 34h56l-7 70a6 6 0 0 1-6 5H45a6 6 0 0 1-6-5z" fill="#a895dd"
                        ></path>
                        <path d="M35.5 58h49l-2.4 24H37.9z" fill="#ece9df"></path>
                        <rect x="27" y="22" width="66" height="14" rx="5" fill="#8d79cf"></rect>
                        <rect x="38" y="14" width="44" height="10" rx="4" fill="#a895dd"></rect>
                      </svg>
                    </div>
                    <p class="tp-app-name">Reusable Coffee Cup</p>
                    <p class="tp-app-price">$24.99</p>
                    <p class="tp-app-desc">Keeps your drinks hot or cold for hours.</p>
                    <div class="tp-app-actions">
                      <div class="tp-app-btn tp-app-add" data-target="add">
                        <span class="tp-app-add-a">Add to cart</span>
                        <span class="tp-app-add-b">Added ✓</span>
                      </div>
                      <div class="tp-app-btn tp-app-checkout" data-target="checkout">Checkout</div>
