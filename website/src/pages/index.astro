---
import '../styles/global.css'
import { existsSync, readFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { Code } from 'astro:components'
import type { ComponentProps } from 'astro/types'

// Every code block on the page is highlighted at build time by Astro's <Code>
// (Shiki) with this small theme drawn from the site palette, so the hero, the
// API tabs and the one-liners all read the same. Backgrounds come from the
// surrounding cards, not the theme.
type CodeTheme = NonNullable<ComponentProps<typeof Code>['theme']>
const codeTheme: CodeTheme = {
  name: 'tapsmith',
  type: 'dark',
  colors: { 'editor.background': '#00000000', 'editor.foreground': '#d4cfc8' },
  tokenColors: [
    {
      scope: ['comment', 'punctuation.definition.comment'],
      settings: { foreground: '#7a7570', fontStyle: 'italic' },
    },
    { scope: ['string', 'punctuation.definition.string'], settings: { foreground: '#e8a86c' } },
    {
      scope: [
        'keyword',
        'storage.type',
        'storage.modifier',
        'keyword.control',
        'keyword.operator.expression',
        'keyword.operator.new',
      ],
      settings: { foreground: '#e8914b' },
    },
    {
      scope: ['entity.name.function', 'support.function', 'entity.name.command'],
      settings: { foreground: '#9fc1e0' },
    },
    {
      scope: [
        'meta.object-literal.key',
        'variable.other.property',
        'support.variable.property',
        'support.type.property-name',
      ],
      settings: { foreground: '#cfc3ad' },
    },
    {
      scope: ['constant.numeric', 'constant.language', 'support.constant'],
      settings: { foreground: '#d9a066' },
    },
    {
      scope: [
        'variable.parameter',
        'variable.other.readwrite',
        'variable.other.object',
        'variable.other.constant',
      ],
      settings: { foreground: '#d4cfc8' },
    },
    {
      scope: ['punctuation', 'meta.brace', 'keyword.operator', 'storage.type.function.arrow'],
      settings: { foreground: '#a39d95' },
    },
    {
      scope: ['keyword.operator.arrow', 'storage.type.function.arrow'],
      settings: { foreground: '#e8914b' },
    },
  ],
}

const codeSnippet = `import { test, expect } from "tapsmith"

test("user can complete checkout", async ({ device }) => {
  await device.getByRole("button", { name: "Add to cart" }).tap()
  await device.getByText("Checkout").tap()

  // mock the payment API
  await device.route("**/api/payment", async (route) => {
    await route.fulfill({ json: { status: "success" } })
  })

  await expect(device.getByText("Order Confirmed")).toBeVisible()
})`

// Cache-busting version for the demo video, written by scripts/sync-promo.mjs
// at build time from the fetched file's hash. Read with fs (not an import) so
// `astro check` works on a checkout that has not run the sync.
// astro build runs with the website directory as cwd (npm run build)
const promoVersionFile = resolve(process.cwd(), 'src', 'promo-version.json')
const promoVersion: string | null = existsSync(promoVersionFile)
  ? (JSON.parse(readFileSync(promoVersionFile, 'utf8')).v ?? null)
  : null
const promoSrc = promoVersion ? `/promo.mp4?v=${promoVersion}` : '/promo.mp4'

// GitHub mark (octicon), used inline next to the GitHub links
const githubMark =
  '<svg class="tp-gh-mark" width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>'

const snippets = {
  locators: `// Same readable API across platforms
await device.getByRole("button", { name: "Sign in" }).tap()
await device.getByLabel("Email").type("alex@tapsmith.dev")
await device.getByText("Forgot password?").tap()`,
  network: `// Mock any HTTP/HTTPS call, no proxy setup
await device.route("**/api/feed", route =>
  route.fulfill({ json: fixtures.emptyFeed })
)
await device.route("**/payment", route => route.abort())`,
  gestures: `// Precise gesture control
await device.swipe("left")
await device.getByRole("image").pinchOut({ scale: 2 })
await device.getByLabel("Reorder").dragTo(device.getByText("Pinned"))`,
}

const comparisonRows = [
  ['Playwright-style TypeScript API', 'Y', 'N', 'N', 'P'],
  ['Reusable helpers, loops & fixtures', 'Y', 'Y', 'P', 'Y'],
  ['iOS + Android single suite', 'Y', 'Y', 'Y', 'Y'],
  // Appium: a server plus a driver per platform, each on its own release
  // train, plus capabilities to keep in step with Xcode / Android. Maestro's
  // single CLI install is genuinely easy. Detox needs native project
  // integration, applesimutils and a Jest/runner config per app.
  ['One npm install, no server or drivers', 'Y', 'N', 'Y', 'P'],
  ['Auto-waiting on every action', 'Y', 'N', 'Y', 'Y'],
  ['Rich assertions with auto-retry', 'Y', 'N', 'P', 'P'],
  ['Network mocking (no proxy, no mock server)', 'Y', 'P', 'N', 'N'],
  // Appium: file push/pull primitives exist, but no container snapshot, no
  // Keystore-preserving restore and no runner integration. Maestro and Detox
  // only clear state (clearState / launchApp({ delete }), resetAppState).
  ['Save & restore app state (log in once)', 'Y', 'P', 'N', 'N'],
  ['Trace viewer', 'Y', 'N', 'N', 'P'],
  ['CI sharding with merged reports', 'Y', 'N', 'P', 'P'],
  // Appium: two driver sessions in one test is a documented pattern, but the
  // test orchestrates them itself and nothing joins the two devices' traces.
  // Maestro (issue #2957) and Detox (issue #393) have no way to drive two
  // devices from one flow/test.
  ['Multi-device tests (two devices, one test)', 'Y', 'P', 'N', 'N'],
  ['Interactive UI mode', 'Y', 'N', 'Y', 'N'],
  ['MCP for AI agents (locators, traces)', 'Y', 'P', 'P', 'N'],
]

const threeThings = [
  {
    n: '1',
    title: 'Mock the network without a mock server.',
    body: 'In every other framework, mocking an API means a separate mock server, a proxy with certificate fiddling, or a special build of your app. In Tapsmith it’s <code>device.route("**/api/payment", r => r.fulfill({ json }))</code>. One line, inline, done.',
  },
  {
    n: '2',
    title: 'A real language, not a YAML ceiling.',
    body: 'Maestro flows are brilliantly simple, right up until the suite grows and logic ends up scattered across YAML, env-var parameters, and <code>runScript</code> snippets. Tapsmith tests are plain TypeScript: extract helpers, loop over fixtures, share setup between tests, and refactor with autocomplete and type-checking behind you.',
  },
  {
    n: '3',
    title: 'Replay the failure, don’t reconstruct it.',
    body: 'Every run records a trace: every tap, every network call, every frame. When a test fails at 3 am, open the trace viewer and scrub through it like a video instead of staring at a stack trace.',
  },
  {
    n: '4',
    title: 'Set up in minutes, not sprints.',
    body: 'Appium means a server, a driver per platform, a capabilities blob, and keeping all three in step with every Xcode and Android release. Tapsmith is one npm package: the daemon, the device agents and the trace viewer come with it, <code>tapsmith init</code> writes your config, and <code>tapsmith doctor</code> tells you what’s missing. No server to start, no drivers to update.',
  },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tapsmith: Playwright-style testing for native mobile apps</title>
    <meta
      name="description"
      content="A test framework for native iOS and Android. Same locators, same auto-waiting, same trace viewer as Playwright, rebuilt for real devices."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      ;(function () {
        var stored = localStorage.getItem('starlight-theme')
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        var theme = stored === 'dark' || (!stored && prefersDark) ? 'dark' : 'light'
        document.documentElement.setAttribute('data-theme', theme)
      })()
    </script>
  </head>
  <body>
    <!-- 1. Sticky header -->
    <header class="tp-header">
      <div class="tp-container tp-header-inner">
        <a href="/" class="tp-logo">
          <img src="/logo.png" alt="Tapsmith" class="tp-logo-img tp-logo-light" />
          <img src="/logo-dark.png" alt="Tapsmith" class="tp-logo-img tp-logo-dark" />
        </a>
        <nav class="tp-nav" id="tp-nav">
          <a href="/getting-started/">Docs</a>
          <a href="/reference/api/locators/">API</a>
          <a href="/guides/network/">Guides</a>
          <a
            href="https://github.com/tapsmith/tapsmith"
            target="_blank"
            rel="noopener"
            class="tp-link-icon"><Fragment set:html={githubMark} />GitHub</a
          >
        </nav>
        <div class="tp-header-actions">
          <button class="tp-theme-toggle" type="button" aria-label="Toggle theme">
            <svg
              class="tp-icon-sun"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"
              ></line><line x1="12" y1="21" x2="12" y2="23"></line><line
                x1="4.22"
                y1="4.22"
                x2="5.64"
                y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line
                x1="1"
                y1="12"
                x2="3"
                y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line
                x1="4.22"
                y1="19.78"
                x2="5.64"
                y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg
            >
            <svg
              class="tp-icon-moon"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
            >
          </button>
          <a href="/getting-started/" class="tp-btn-solid tp-btn-sm">Get started →</a>
          <button
            class="tp-nav-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="tp-nav"
          >
            <svg
              class="tp-icon-menu"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"
              ></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
            >
            <svg
              class="tp-icon-close"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"
              ></line></svg
            >
          </button>
        </div>
      </div>
    </header>

    <main>
      <!-- 2. Hero -->
      <section class="tp-hero">
        <div class="tp-container">
          <h1 class="tp-hero-h1">
            Mobile tests that <span class="tp-muted">feel</span><br />
            <span class="tp-muted">like</span> web tests.
          </h1>

          <p class="tp-hero-lead">
            Tapsmith is a test framework for native iOS and Android. We took the parts of Playwright
            that engineers love: the locators, the auto&#8209;waiting, the trace viewer, and rebuilt
            them for real devices.
          </p>

          <div class="tp-hero-ctas">
            <a href="/getting-started/" class="tp-btn-solid">Get started →</a>
            <a href="https://www.npmjs.com/package/tapsmith" class="tp-btn-ghost tp-btn-npm">
              <span class="tp-npm-dollar">$</span>&nbsp; npm i tapsmith&nbsp;<span
                class="tp-npm-icon">⧉</span
              >
            </a>
          </div>

          <div class="tp-hero-visual">
            <div class="tp-code-window">
              <div class="tp-code-chrome">
                <div class="tp-chrome-dots">
                  <span class="tp-chrome-dot"></span>
                  <span class="tp-chrome-dot"></span>
                  <span class="tp-chrome-dot"></span>
                </div>
                <span class="tp-code-filename">checkout.test.ts</span>
                <span class="tp-code-status">
                  <span class="tp-dot-green"></span>
                  passed · 1.4s
                </span>
              </div>
              <Code class="tp-code-body" code={codeSnippet} lang="ts" theme={codeTheme} />
            </div>
            <div class="tp-hero-phone">
              <img src="/hero-iphone.png" alt="Tapsmith driving an iOS app" class="tp-phone-img" />
            </div>
          </div>
        </div>
      </section>

      <!-- 2b. Demo video -->
      <section class="tp-demo" id="demo">
        <div class="tp-container">
          <video
            class="tp-demo-video"
            src={promoSrc}
            poster="/promo-poster.jpg"
            controls
            preload="metadata"
            playsinline></video>
          <p class="tp-demo-caption">
            Tapsmith in 2 minutes: UI mode, the locator playground, multi-device tests, the MCP
            server, and the trace viewer.
          </p>
        </div>
      </section>

      <!-- 4. Three things -->
      <section class="tp-three">
        <div class="tp-container">
          <div class="tp-three-header">
            <h2 class="tp-h2-large">The pain you're used to, gone.</h2>
            <a href="/guides/locators/" class="tp-btn-ghost tp-btn-guide">Read the guide →</a>
          </div>
          <div class="tp-three-rows">
            {
              threeThings.map((item) => (
                <div class="tp-three-row">
                  <span class="tp-three-num">{item.n}</span>
                  <h3 class="tp-three-title">{item.title}</h3>
                  <p class="tp-three-body" set:html={item.body} />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- 5. Comparison table -->
      <section class="tp-compare">
        <div class="tp-container">
          <div class="tp-compare-header">
            <h2 class="tp-h2-large">We've all tried the others.</h2>
            <p class="tp-compare-desc">
              This is a snapshot, not a sales pitch. Every tool in this list does something well; we
              just think the table tilts our way for most teams shipping consumer mobile apps in
              2026.
            </p>
          </div>
          <div class="tp-table-wrap">
            <div class="tp-table">
              <div class="tp-table-head">
                <div class="tp-table-cell tp-table-feature">Feature</div>
                <div class="tp-table-cell tp-table-col tp-table-us">Tapsmith</div>
                <div class="tp-table-cell tp-table-col">Appium</div>
                <div class="tp-table-cell tp-table-col">Maestro</div>
                <div class="tp-table-cell tp-table-col">Detox</div>
              </div>
              {
                comparisonRows.map((row, idx) => (
                  <div
                    class:list={[
                      'tp-table-row',
                      { 'tp-table-row-last': idx === comparisonRows.length - 1 },
                    ]}
                  >
                    <div class="tp-table-cell tp-table-feature">{row[0]}</div>
                    <div class="tp-table-cell tp-table-col tp-table-us-col" data-mark={row[1]}>
                      <span
                        class:list={[
                          'tp-mark',
                          `tp-mark-${row[1].toLowerCase()}`,
                          'tp-mark-highlight',
                        ]}
                      >
                        {row[1] === 'Y' ? '✓' : row[1] === 'P' ? '◐' : '—'}
                      </span>
                    </div>
                    <div class="tp-table-cell tp-table-col" data-mark={row[2]}>
                      <span class:list={['tp-mark', `tp-mark-${row[2].toLowerCase()}`]}>
                        {row[2] === 'Y' ? '✓' : row[2] === 'P' ? '◐' : '—'}
                      </span>
                    </div>
                    <div class="tp-table-cell tp-table-col" data-mark={row[3]}>
                      <span class:list={['tp-mark', `tp-mark-${row[3].toLowerCase()}`]}>
                        {row[3] === 'Y' ? '✓' : row[3] === 'P' ? '◐' : '—'}
                      </span>
                    </div>
                    <div class="tp-table-cell tp-table-col" data-mark={row[4]}>
                      <span class:list={['tp-mark', `tp-mark-${row[4].toLowerCase()}`]}>
                        {row[4] === 'Y' ? '✓' : row[4] === 'P' ? '◐' : '—'}
                      </span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="tp-table-legend">
            ✓ supported &nbsp;&nbsp; ◐ partial / via plugin &nbsp;&nbsp; — not available
            &nbsp;&nbsp; last verified Sep 2026
          </p>
        </div>
      </section>

      <!-- 6. API snippets -->
      <section class="tp-snippets">
        <div class="tp-container">
          <div class="tp-snippets-header">
            <h2 class="tp-h2-medium">An API you can guess your way through.</h2>
            <div class="tp-tabs" role="tablist" aria-label="Code examples">
              <button
                class="tp-tab tp-tab-active"
                data-tab="locators"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="panel-locators"
                id="tab-locators">Locators</button
              >
              <button
                class="tp-tab"
                data-tab="network"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-network"
                id="tab-network">Network</button
              >
              <button
                class="tp-tab"
                data-tab="gestures"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="panel-gestures"
                id="tab-gestures">Gestures</button
              >
            </div>
          </div>
          <div class="tp-snippet-panel">
            <div
              class="tp-snippet-code"
              data-snippet="locators"
              role="tabpanel"
              id="panel-locators"
              aria-labelledby="tab-locators"
            >
              <Code code={snippets.locators} lang="ts" theme={codeTheme} />
            </div>
            <div
              class="tp-snippet-code"
              data-snippet="network"
              role="tabpanel"
              id="panel-network"
              aria-labelledby="tab-network"
              hidden
            >
              <Code code={snippets.network} lang="ts" theme={codeTheme} />
            </div>
            <div
              class="tp-snippet-code"
              data-snippet="gestures"
              role="tabpanel"
              id="panel-gestures"
              aria-labelledby="tab-gestures"
              hidden
            >
              <Code code={snippets.gestures} lang="ts" theme={codeTheme} />
            </div>
          </div>
        </div>
      </section>

      <!-- 8. Trace viewer + UI mode -->
      <section class="tp-devtools">
        <div class="tp-container">
          <div class="tp-devtools-header">
            <h2 class="tp-h2-large">See exactly what happened, and when.</h2>
          </div>
          <div class="tp-devtools-grid">
            <div class="tp-devtools-card">
              <h3 class="tp-devtools-title">Trace viewer</h3>
              <p class="tp-devtools-body">
                Every test run records a full trace. Scrub through a timeline of screenshots, see
                every tap and gesture overlaid on the screen, inspect every network request and
                response. When a test fails in CI, download the trace and replay it locally. No
                guessing, no "works on my machine."
              </p>
              <button
                type="button"
                class="tp-devtools-zoom"
                aria-label="Enlarge trace viewer screenshot"
              >
                <img
                  src="/trace-viewer.png"
                  alt="Tapsmith trace viewer showing a failed login test: timeline of screenshots, action log with the failed assertion, the app's error state, and the error with a source snippet"
                  class="tp-devtools-img"
                />
              </button>
              <div class="tp-devtools-code">
                <Code
                  class="tp-snippet-code"
                  code="npx tapsmith show-trace trace.zip"
                  lang="sh"
                  theme={codeTheme}
                />
              </div>
            </div>
            <div class="tp-devtools-card">
              <h3 class="tp-devtools-title">UI mode</h3>
              <p class="tp-devtools-body">
                A browser-based interactive runner. Click any test to run it, see results stream in
                live, browse traces and screenshots inline, and mirror the device screen, all
                without leaving the browser.
              </p>
              <button
                type="button"
                class="tp-devtools-zoom"
                aria-label="Enlarge UI mode screenshot"
              >
                <img
                  src="/ui-mode.png"
                  alt="Tapsmith UI mode running a network-mocking test across Android and iOS, with the test tree, trace actions, mocked network response, and live device mirrors"
                  class="tp-devtools-img"
                />
              </button>
              <div class="tp-devtools-code">
                <Code
                  class="tp-snippet-code"
                  code="npx tapsmith test --ui"
                  lang="sh"
                  theme={codeTheme}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 9. CTA card -->
      <section class="tp-cta">
        <div class="tp-container">
          <div class="tp-cta-card">
            <div class="tp-cta-left">
              <h2 class="tp-cta-h2">
                Spend the rest of the afternoon on something more interesting.
              </h2>
              <p class="tp-cta-sub">
                Install Tapsmith, point it at your app, and write your first test in five minutes.
              </p>
            </div>
            <div class="tp-cta-right">
              <a href="/getting-started/" class="tp-btn-solid">Get started →</a>
              <span class="tp-cta-alt"
                >or <a href="/getting-started/" class="tp-cta-link"
                  >read the 5&#8209;min walkthrough</a
                ></span
              >
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Lightbox for enlarged screenshots -->
    <dialog class="tp-lightbox" id="tp-lightbox">
      <img class="tp-lightbox-img" src="" alt="" />
    </dialog>

    <!-- 10. Footer -->
    <footer class="tp-footer">
      <div class="tp-container">
        <div class="tp-footer-top">
          <div class="tp-footer-brand">
            <a href="/" class="tp-logo">
              <img
                src="/logo.png"
                alt="Tapsmith"
                class="tp-logo-img tp-logo-footer tp-logo-light"
              />
              <img
                src="/logo-dark.png"
                alt="Tapsmith"
