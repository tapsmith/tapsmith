      .tp-devtools-header {
        margin-bottom: 40px;
        max-width: 620px;
      }
      .tp-devtools-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .tp-devtools-card {
        border: 1px solid var(--tp-border);
        border-radius: var(--tp-radius-lg);
        background: var(--tp-surface);
        padding: 32px;
        display: grid;
        grid-template-columns: 320px 1fr;
        grid-template-rows: auto 1fr auto;
        gap: 8px 32px;
      }
      .tp-devtools-card .tp-devtools-title {
        grid-column: 1;
      }
      .tp-devtools-card .tp-devtools-body {
        grid-column: 1;
      }
      .tp-devtools-card .tp-devtools-zoom {
        grid-column: 2;
        grid-row: 1 / -1;
        align-self: center;
      }
      .tp-devtools-card .tp-devtools-code {
        grid-column: 1;
      }
      .tp-devtools-title {
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .tp-devtools-body {
        font-size: 15px;
        color: var(--tp-ink-2);
        line-height: 1.7;
      }
      .tp-devtools-zoom {
        display: block;
        padding: 0;
        margin: 0;
        border: none;
        background: none;
        cursor: zoom-in;
        border-radius: var(--tp-radius);
      }
      .tp-devtools-img {
        display: block;
        width: 100%;
        border-radius: var(--tp-radius);
        border: 1px solid var(--tp-border);
        box-shadow: 0 4px 24px -4px rgba(0, 0, 0, 0.1);
      }
      .tp-lightbox {
        border: none;
        padding: 0;
        margin: auto;
        max-width: min(1400px, 92vw);
        max-height: 92vh;
        background: transparent;
        overflow: visible;
        outline: none;
      }
      .tp-lightbox::backdrop {
        background: rgba(10, 10, 12, 0.82);
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
      }
      .tp-lightbox-img {
        display: block;
        max-width: 100%;
        max-height: 92vh;
        border-radius: var(--tp-radius);
        cursor: zoom-out;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
      }
      .tp-devtools-code {
        margin-top: auto;
        background: var(--tp-code-bg);
        border-radius: var(--tp-radius);
        padding: 14px 18px;
        border: 1px solid var(--tp-code-border);
      }
      .tp-devtools-code .tp-snippet-code {
        font-size: 13px;
        line-height: 1.5;
      }

      /* ─── 9. CTA card ─── */
      .tp-cta {
        padding: 0 0 120px;
      }
      .tp-cta-card {
        border: 1px solid var(--tp-border);
        border-radius: var(--tp-radius-lg);
        background: var(--tp-surface);
        padding: 48px 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 40px;
      }
      .tp-cta-left {
        max-width: 520px;
      }
      .tp-cta-h2 {
        font-size: 28px;
        font-weight: 600;
        letter-spacing: -0.025em;
        margin-bottom: 8px;
      }
      .tp-cta-sub {
        font-size: 15px;
        color: var(--tp-ink-3);
      }
      .tp-cta-right {
        display: flex;
        flex-direction: column;
        gap: 10px;
        align-items: flex-end;
        flex-shrink: 0;
      }
      .tp-cta-alt {
        font-family: var(--tp-font-mono);
        font-size: 12px;
        color: var(--tp-ink-4);
      }
      .tp-cta-link {
        color: var(--tp-ink-4);
      }

      /* ─── 10. Footer ─── */
      .tp-footer {
        background: var(--tp-bg);
        border-top: 1px solid var(--tp-border);
        padding: 48px 0;
      }
      .tp-footer-top {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 40px;
        align-items: flex-start;
      }
      .tp-footer-brand {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .tp-footer-desc {
        font-size: 13px;
        color: var(--tp-ink-3);
        max-width: 240px;
        line-height: 1.55;
      }
      .tp-footer-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .tp-footer-col h4 {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--tp-ink-4);
        margin-bottom: 4px;
      }
      .tp-footer-col a {
        font-size: 13px;
        color: var(--tp-ink-2);
        text-decoration: none;
        transition: color 0.1s;
      }
      .tp-footer-col a:hover {
        color: var(--tp-ink);
      }
      .tp-footer-bottom {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid var(--tp-border);
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: var(--tp-ink-4);
      }
      .tp-footer-meta {
        font-family: var(--tp-font-mono);
      }

      /* ─── Responsive ─── */
      @media (max-width: 900px) {
        .tp-container {
          padding: 0 24px;
        }
        .tp-hero-h1 {
          font-size: clamp(40px, 8vw, 64px);
        }
        .tp-hero-visual {
          padding-right: 0;
        }
        .tp-hero-phone {
          display: none;
        }
        .tp-three-header {
          flex-direction: column;
          gap: 24px;
          align-items: flex-start;
        }
        .tp-three-row {
          grid-template-columns: 48px 1fr;
          gap: 16px;
        }
        .tp-three-body {
          grid-column: 2;
        }
        .tp-snippets-header {
          flex-direction: column;
          gap: 20px;
          align-items: flex-start;
        }
        .tp-devtools-card {
          grid-template-columns: 1fr;
        }
        .tp-devtools-card .tp-devtools-zoom {
          grid-column: 1;
          grid-row: auto;
        }
        .tp-devtools-card .tp-devtools-code {
          grid-column: 1;
        }
        .tp-cta-card {
          flex-direction: column;
          text-align: center;
          padding: 36px 28px;
        }
        .tp-cta-right {
          align-items: center;
        }
        .tp-footer-top {
          grid-template-columns: 1fr 1fr;
        }
        /* Keep the feature column readable while the table scrolls */
        .tp-table .tp-table-feature {
          position: sticky;
          left: 0;
          z-index: 1;
          background: var(--tp-surface);
          box-shadow: 1px 0 0 var(--tp-border-2);
        }
        .tp-table-head .tp-table-feature {
          background: var(--tp-bg-2);
          box-shadow: 1px 0 0 var(--tp-border);
        }
      }

      @media (max-width: 640px) {
        /* Collapse the nav into a hamburger dropdown under the sticky header */
        .tp-nav-toggle {
          display: flex;
        }
        .tp-nav {
          display: none;
          position: absolute;
          top: 64px;
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 0;
          background: var(--tp-bg);
          border-bottom: 1px solid var(--tp-border);
          padding: 4px 24px 8px;
          box-shadow: 0 24px 32px -28px rgba(11, 16, 32, 0.25);
        }
        .tp-nav-open .tp-nav {
          display: flex;
        }
        .tp-nav a {
          padding: 12px 0;
          font-size: 15px;
        }
        /* Hero */
        .tp-hero {
          padding: 48px 0 56px;
        }
        .tp-hero-h1 br {
          display: none;
        }
        .tp-hero-lead {
          font-size: 17px;
        }
        .tp-hero-ctas {
          flex-direction: column;
          margin-bottom: 48px;
        }
        .tp-hero-visual {
          padding-top: 0;
        }
        .tp-code-body {
          padding: 16px 18px;
          font-size: 12.5px;
          line-height: 1.75;
        }

        /* Section rhythm */
        .tp-three {
          padding: 72px 0 64px;
        }
        .tp-three-header {
          margin-bottom: 32px;
        }
        .tp-three-row {
          grid-template-columns: 1fr;
          gap: 8px;
          padding: 28px 0;
        }
        .tp-three-num {
          display: block;
        }
        .tp-three-body {
          grid-column: 1;
        }
        .tp-compare {
          padding: 24px 0 80px;
        }
        .tp-snippets {
          padding: 0 0 80px;
        }
        .tp-devtools {
          padding: 24px 0 80px;
        }
        .tp-cta {
          padding: 0 0 80px;
        }

        /* Comparison table: edge-to-edge scroll, tighter cells */
        .tp-table-wrap {
          margin: 0 -24px;
          padding: 0 24px;
        }
        .tp-table {
          min-width: 580px;
        }
        .tp-table-head .tp-table-feature,
        .tp-table-head .tp-table-col {
          padding: 12px 14px;
        }
        .tp-table-row .tp-table-feature {
          padding: 12px 14px;
          font-size: 13px;
        }
        .tp-table-row .tp-table-col {
          padding: 12px 14px;
        }

        /* Code panels */
        .tp-snippet-panel {
          padding: 20px 18px;
        }
        .tp-snippet-code {
          font-size: 13px;
        }
        .tp-devtools-card {
          padding: 20px;
        }

        /* Footer */
        .tp-footer-top {
          grid-template-columns: 1fr;
        }
        .tp-footer-bottom {
          flex-direction: column;
          gap: 8px;
        }

        /* Type scale */
        .tp-h2-large {
          font-size: 28px;
        }
        .tp-h2-medium {
          font-size: 24px;
        }
      }
    </style>
  </body>
</html>
