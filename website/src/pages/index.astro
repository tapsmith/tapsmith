    <script>
      document.querySelectorAll('.tp-theme-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme')
          const next = current === 'dark' ? 'light' : 'dark'
          document.documentElement.setAttribute('data-theme', next)
          localStorage.setItem('starlight-theme', next)
        })
      })

      const header = document.querySelector('.tp-header')
      const navToggle = document.querySelector('.tp-nav-toggle')
      if (header && navToggle) {
        navToggle.addEventListener('click', () => {
          const open = header.classList.toggle('tp-nav-open')
          navToggle.setAttribute('aria-expanded', String(open))
          navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
        })
        // Close the menu when a nav link is tapped (same-page anchors don't reload)
        header.querySelectorAll('.tp-nav a').forEach((link) => {
          link.addEventListener('click', () => {
            header.classList.remove('tp-nav-open')
            navToggle.setAttribute('aria-expanded', 'false')
            navToggle.setAttribute('aria-label', 'Open menu')
          })
        })
      }

      const tablist = document.querySelector('[role="tablist"]')
      if (tablist) {
        const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'))

        function activate(tab: Element) {
          tabs.forEach((t) => {
            t.classList.remove('tp-tab-active')
            t.setAttribute('aria-selected', 'false')
            t.setAttribute('tabindex', '-1')
          })
          tab.classList.add('tp-tab-active')
          tab.setAttribute('aria-selected', 'true')
          tab.setAttribute('tabindex', '0')
          ;(tab as HTMLElement).focus()
          const id = tab.getAttribute('data-tab')
          document.querySelectorAll('[role="tabpanel"]').forEach((panel) => {
            ;(panel as HTMLElement).hidden = panel.getAttribute('data-snippet') !== id
          })
        }

        tabs.forEach((btn) => {
          btn.addEventListener('click', () => {
            activate(btn)
          })
          btn.addEventListener('keydown', (e) => {
            const ke = e as KeyboardEvent
            const idx = tabs.indexOf(btn)
            if (ke.key === 'ArrowRight') {
              e.preventDefault()
              activate(tabs[(idx + 1) % tabs.length])
            } else if (ke.key === 'ArrowLeft') {
              e.preventDefault()
              activate(tabs[(idx - 1 + tabs.length) % tabs.length])
            } else if (ke.key === 'Home') {
              e.preventDefault()
              activate(tabs[0])
            } else if (ke.key === 'End') {
              e.preventDefault()
              activate(tabs[tabs.length - 1])
            }
          })
        })

        tabs.forEach((t, i) => {
          t.setAttribute('tabindex', i === 0 ? '0' : '-1')
        })
      }

      const lightbox = document.getElementById('tp-lightbox') as HTMLDialogElement | null
      if (lightbox) {
        const lightboxImg = lightbox.querySelector('.tp-lightbox-img') as HTMLImageElement
        document.querySelectorAll('.tp-devtools-zoom').forEach((btn) => {
          btn.addEventListener('click', () => {
            const img = btn.querySelector('img')
            if (!img) return
            lightboxImg.src = img.src
            lightboxImg.alt = img.alt
            lightbox.showModal()
          })
        })
        // Close on any click (backdrop or image)
        lightbox.addEventListener('click', () => {
          lightbox.close()
        })
        // Clear the image on close so the next open doesn't flash the old one
        lightbox.addEventListener('close', () => {
          lightboxImg.removeAttribute('src')
          lightboxImg.removeAttribute('alt')
        })
      }
    </script>

