      }
      .tp-term-caret {
        display: none;
        width: 7px;
        height: 1.05em;
        margin-left: 2px;
        vertical-align: text-bottom;
        background: #d4cfc8;
        animation: tp-blink 1s steps(1) infinite;
      }
      .tp-typing .tp-term-caret {
        display: inline-block;
      }

      /* The device */
      .tp-device {
        display: flex;
        justify-content: center;
      }
      .tp-phone {
        --app: #5b4fc0;
        --app-ink: #17152b;
        position: relative;
        width: 300px;
        aspect-ratio: 300 / 612;
        padding: 10px;
        border-radius: 50px;
        background: #0e0d0c;
        box-shadow:
          0 0 0 1.5px #4a4540,
          0 40px 80px -24px rgba(0, 0, 0, 0.55);
        flex-shrink: 0;
      }
      .tp-phone-screen {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 40px;
        background: #fbfaff;
        color: var(--app-ink);
        overflow: hidden;
        font-family: var(--tp-font-sans);
        letter-spacing: -0.01em;
      }
      .tp-phone-status {
        position: relative;
        z-index: 3;
        height: 44px;
        padding: 6px 24px 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 600;
      }
      .tp-phone-island {
        position: absolute;
        left: 50%;
        top: 10px;
        width: 84px;
        height: 24px;
        margin-left: -42px;
        border-radius: 14px;
        background: #0e0d0c;
      }
      .tp-phone-batt {
        width: 21px;
        height: 10px;
        border-radius: 3px;
        background: var(--app-ink);
      }
      .tp-phone-home {
        position: absolute;
        left: 50%;
        bottom: 7px;
        width: 100px;
        height: 4px;
        margin-left: -50px;
        border-radius: 4px;
        background: var(--app-ink);
        opacity: 0.85;
        z-index: 3;
      }
      .tp-app {
        position: absolute;
        inset: 44px 0 0;
        padding: 6px 18px 28px;
        display: flex;
        flex-direction: column;
        transition:
          transform 0.5s var(--tp-ease),
          opacity 0.4s;
      }
      .tp-app-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
        font-weight: 600;
        height: 34px;
      }
      .tp-app-back {
        font-size: 22px;
        line-height: 1;
        width: 28px;
      }
      .tp-app-cart {
        position: relative;
        width: 28px;
        display: flex;
        justify-content: flex-end;
      }
      .tp-app-badge {
        position: absolute;
        top: -7px;
        right: -8px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--app);
        color: #fff;
        font-size: 10px;
        font-style: normal;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: scale(0);
        transition: transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1);
      }
      .tp-app-photo {
        margin-top: 8px;
        flex: 1;
        min-height: 0;
        border-radius: 18px;
        background: #efecfb;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .tp-app-name {
        margin-top: 14px;
        font-size: 17px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .tp-app-price {
        font-size: 14px;
        margin-top: 2px;
      }
      .tp-app-desc {
        font-size: 12px;
        line-height: 1.45;
        color: #5d5a70;
        margin-top: 6px;
      }
      .tp-app-actions {
        position: relative;
        margin-top: 14px;
        height: 96px;
      }
      .tp-app-btn {
        position: absolute;
        left: 0;
        right: 0;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 600;
        transition:
          background 0.3s,
          color 0.3s,
          transform 0.45s var(--tp-ease),
          opacity 0.3s;
      }
      .tp-app-add {
        top: 0;
        background: var(--app);
        color: #fff;
      }
      .tp-app-add-b {
        display: none;
      }
      .tp-app-checkout {
        top: 52px;
        background: var(--app-ink);
        color: #fff;
        opacity: 0;
        transform: translateY(14px);
      }
      .tp-app-done {
        background: #fbfaff;
        align-items: center;
        justify-content: center;
        text-align: center;
        transform: translateX(100%);
      }
      .tp-app-spinner {
        position: absolute;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 3px solid #e2def5;
        border-top-color: var(--app);
        animation: tp-spin 0.8s linear infinite;
        transition: opacity 0.25s;
      }
      @keyframes tp-spin {
        to {
          transform: rotate(360deg);
        }
      }
      .tp-app-confirm {
        opacity: 0;
        transform: scale(0.94);
        transition:
          opacity 0.35s,
          transform 0.45s var(--tp-ease);
      }
      .tp-app-tick {
        width: 56px;
        height: 56px;
        margin: 0 auto 38px;
        border-radius: 50%;
        background: #e3f6e8;
        color: #1f9d48;
        font-size: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .tp-app-confirm-title {
        font-size: 19px;
        font-weight: 600;
        letter-spacing: -0.02em;
      }
      .tp-app-confirm-sub {
        font-size: 12.5px;
        color: #5d5a70;
        margin-top: 6px;
      }
      /* What Tapsmith adds on top of the app: the mocked route, the tap, the assertion */
      .tp-phone-net {
        position: absolute;
        z-index: 4;
        left: 50%;
        top: 98px;
        transform: translate(-50%, -8px);
        padding: 4px 10px;
        border-radius: var(--tp-radius-pill);
        background: #1e1b18;
        color: #d4cfc8;
        font-family: var(--tp-font-mono);
        font-size: 9.5px;
        letter-spacing: 0;
        white-space: nowrap;
        opacity: 0;
        transition:
          opacity 0.3s,
          transform 0.4s var(--tp-ease);
      }
      .tp-phone-net b {
        color: var(--tp-ember);
        font-weight: 500;
      }
      .tp-tap {
        position: absolute;
        z-index: 5;
        width: 44px;
        height: 44px;
        margin: -22px 0 0 -22px;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        background: rgba(232, 145, 75, 0.38);
        box-shadow: 0 0 0 1.5px var(--tp-ember);
      }
      .tp-tap-go {
        animation: tp-tap 0.75s ease-out;
      }
      @keyframes tp-tap {
        0% {
          opacity: 0;
          transform: scale(0.3);
        }
        25% {
          opacity: 1;
          transform: scale(0.75);
        }
        100% {
          opacity: 0;
          transform: scale(1.7);
        }
      }
      .tp-probe {
        position: absolute;
        z-index: 4;
        border: 1.5px solid var(--tp-ember);
        border-radius: 6px;
        background: rgba(232, 145, 75, 0.12);
        opacity: 0;
        transition: opacity 0.3s;
        pointer-events: none;
      }
      .tp-probe i {
        position: absolute;
        left: 50%;
        bottom: calc(100% + 7px);
        transform: translateX(-50%);
        padding: 3px 8px;
        border-radius: 5px;
        background: #1e1b18;
        color: #e8a86c;
        font-family: var(--tp-font-mono);
        font-size: 9.5px;
        font-style: normal;
        letter-spacing: 0;
        white-space: nowrap;
      }
      /* Steps: 1 route mocked · 2 added to cart · 3 checking out · 4 confirmed · 5 asserted */
      .tp-phone[data-step='1'] .tp-phone-net,
      .tp-phone[data-step='2'] .tp-phone-net,
      .tp-phone[data-step='3'] .tp-phone-net {
        opacity: 1;
        transform: translate(-50%, 0);
      }
      .tp-phone:is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5'])
        .tp-app-badge {
        transform: scale(1);
      }
      .tp-phone:is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5']) .tp-app-add {
        background: #e7e3f8;
        color: var(--app);
      }
      .tp-phone:is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5'])
        .tp-app-add-a {
        display: none;
      }
      .tp-phone:is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5'])
        .tp-app-add-b {
        display: inline;
      }
      .tp-phone:is([data-step='2'], [data-step='3'], [data-step='4'], [data-step='5'])
        .tp-app-checkout {
        opacity: 1;
        transform: none;
      }
      .tp-phone:is([data-step='3'], [data-step='4'], [data-step='5']) .tp-app-product {
        transform: translateX(-30%);
        opacity: 0;
      }
      .tp-phone:is([data-step='3'], [data-step='4'], [data-step='5']) .tp-app-done {
        transform: none;
      }
      .tp-phone:is([data-step='4'], [data-step='5']) .tp-app-spinner {
        opacity: 0;
      }
      .tp-phone:is([data-step='4'], [data-step='5']) .tp-app-confirm {
        opacity: 1;
        transform: none;
      }
      .tp-phone[data-step='5'] .tp-probe {
        opacity: 1;
      }

      /* ─── The pain, gone ─── */
      .tp-pain {
        padding: 0 0 168px;
      }
      .tp-pain-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid var(--tp-border-3);
      }
      .tp-pain-cell {
        position: relative;
        padding: 40px 48px 48px 0;
        border-bottom: 1px solid var(--tp-border-3);
      }
      .tp-pain-cell:nth-child(even) {
        padding-left: 48px;
        padding-right: 0;
        border-left: 1px solid var(--tp-border-3);
      }
      .tp-pain-title {
        font-family: var(--tp-font-display);
        font-size: clamp(22px, 2.3vw, 30px);
        font-weight: 500;
        letter-spacing: -0.03em;
        line-height: 1.12;
        margin: 0 0 14px;
        max-width: 18ch;
      }
      .tp-pain-body {
        font-size: 15.5px;
        color: var(--tp-ink-2);
        line-height: 1.7;
        max-width: 52ch;
      }
      .tp-pain-body code,
      .tp-faq-a code {
        font-family: var(--tp-font-mono);
        font-size: 0.85em;
        color: var(--tp-ink);
        background: var(--tp-bg-2);
        border: 1px solid var(--tp-border);
        border-radius: var(--tp-radius-sm);
        padding: 1px 6px;
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
      }

      /* ─── Tabs ─── */
      .tp-tabs {
        display: flex;
        gap: 4px;
        padding: 4px;
        border: 1px solid var(--tp-border);
        border-radius: var(--tp-radius-md);
        background: var(--tp-surface);
        flex-shrink: 0;
        max-width: 100%;
        overflow-x: auto;
      }
      .tp-tab {
        padding: 7px 15px;
        border-radius: var(--tp-radius);
        border: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        font-family: var(--tp-font-sans);
        white-space: nowrap;
        background: transparent;
        color: var(--tp-ink-3);
        transition:
          background 0.15s,
          color 0.15s;
      }
      .tp-tab:hover {
        color: var(--tp-ink);
      }
      .tp-tab-active,
      .tp-tab-active:hover {
        background: var(--tp-ink);
        color: var(--tp-bg);
      }

      /* ─── Snippets ─── */
      .tp-snippets {
        padding: 0 0 168px;
      }
      .tp-snippet-panel {
        background: var(--tp-code-bg);
        border-radius: var(--tp-radius-lg);
        padding: 36px 40px;
        border: 1px solid var(--tp-code-border);
        box-shadow: var(--tp-shadow-code);
      }
      .tp-snippet-code {
        margin: 0;
        font-family: var(--tp-font-mono);
        font-size: 14.5px;
        line-height: 1.85;
        color: var(--tp-code-fg);
        /* Long unbreakable tokens must scroll, not widen the mobile layout viewport */
        overflow-x: auto;
      }
      .tp-snippet-code .astro-code,
      pre.tp-snippet-code {
        white-space: pre-wrap;
        overflow-x: auto;
      }

      /* ─── Tooling ─── */
      .tp-tools {
        padding: 0 0 96px;
      }
      .tp-tool-zoom {
        display: block;
        width: 100%;
        padding: 0;
        border: 1px solid var(--tp-border-3);
        border-radius: var(--tp-radius-lg);
        background: var(--tp-surface);
        overflow: hidden;
        cursor: zoom-in;
        box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.35);
      }
      .tp-tool-img {
        width: 100%;
        height: auto;
      }
      .tp-tool-meta {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: 56px;
        padding-top: 32px;
        align-items: start;
      }
      .tp-tool-body {
        font-size: 17px;
        line-height: 1.6;
        color: var(--tp-ink-2);
        max-width: 60ch;
      }
      .tp-tool-side {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .tp-tool-cmd {
        background: var(--tp-code-bg);
        border-radius: var(--tp-radius);
        padding: 14px 18px;
        border: 1px solid var(--tp-code-border);
      }
      .tp-tool-cmd .tp-snippet-code {
        font-size: 13px;
        line-height: 1.5;
      }
      .tp-tool-link {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--tp-ink-2);
        text-decoration: none;
      }
      .tp-tool-link:hover,
      .tp-faq-a a:hover,
      .tp-cta-link:hover {
        color: var(--tp-accent);
      }
      .tp-lightbox {
        border: none;
        padding: 0;
        margin: auto;
        max-width: min(1400px, 92vw);
        max-height: 92vh;
        background: transparent;
        overflow: visible;
        outline: none;
      }
      .tp-lightbox::backdrop {
        background: rgba(10, 10, 12, 0.82);
        -webkit-backdrop-filter: blur(4px);
        backdrop-filter: blur(4px);
      }
      .tp-lightbox-img {
        display: block;
        max-width: 100%;
        max-height: 92vh;
        border-radius: var(--tp-radius);
        cursor: zoom-out;
        box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
      }

      /* ─── Demo video ─── */
      .tp-demo {
        padding: 0 0 168px;
      }
      .tp-demo-video {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: var(--tp-radius-lg);
        border: 1px solid var(--tp-border-3);
        box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.45);
        background: #171310;
      }
      .tp-demo-caption {
        margin-top: 18px;
        text-align: center;
        font-family: var(--tp-font-mono);
        font-size: 12px;
        color: var(--tp-ink-3);
      }

      /* ─── Comparison table ─── */
      .tp-compare {
        padding: 0 0 168px;
      }
      .tp-table-wrap {
        overflow-x: auto;
      }
      .tp-table {
        border: 1px solid var(--tp-border);
        border-radius: var(--tp-radius-md);
        background: var(--tp-surface);
        overflow: hidden;
        min-width: 700px;
      }
      .tp-table-head,
      .tp-table-row {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
      }
      .tp-table-head {
        background: var(--tp-bg-2);
        border-bottom: 1px solid var(--tp-border);
      }
      .tp-table-head .tp-table-feature {
        padding: 16px 20px;
        font-family: var(--tp-font-mono);
        font-size: 12px;
        color: var(--tp-ink-3);
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .tp-table-head .tp-table-col {
        padding: 16px 20px;
        font-size: 13px;
        font-weight: 600;
        color: var(--tp-ink-3);
        border-left: 1px solid var(--tp-border);
      }
      .tp-table-head .tp-table-us {
        color: var(--tp-ink);
        background: var(--tp-surface);
        box-shadow: inset 0 2px 0 var(--tp-ember);
      }
      .tp-table-row {
        border-bottom: 1px solid var(--tp-border-2);
        transition: background 0.15s;
      }
      .tp-table-row:last-child {
        border-bottom: none;
      }
      .tp-table-row:hover {
        background: var(--tp-bg-2);
      }
      .tp-table-row .tp-table-feature {
        padding: 14px 20px;
        font-size: 14px;
        color: var(--tp-ink);
      }
      .tp-table-row .tp-table-col {
        padding: 14px 20px;
        font-size: 13px;
        border-left: 1px solid var(--tp-border-2);
      }
      .tp-table-us-col {
        background: var(--tp-accent-soft);
      }
      .tp-mark-y {
        color: var(--tp-success);
        font-weight: 600;
      }
      .tp-mark-y.tp-mark-highlight {
        color: var(--tp-accent);
      }
      .tp-mark-p {
        color: var(--tp-warning);
        font-weight: 500;
      }
      .tp-mark-n {
        color: var(--tp-ink-5);
      }
      .tp-table-legend {
        font-size: 12px;
        color: var(--tp-ink-4);
        margin-top: 14px;
        font-family: var(--tp-font-mono);
      }

      /* ─── FAQ ─── */
      .tp-faq {
        padding: 0 0 168px;
      }
      .tp-faq-grid {
        display: grid;
        grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: 64px;
        align-items: start;
      }
      .tp-faq .tp-section-head {
        margin-bottom: 0;
        position: sticky;
        top: 112px;
      }
      .tp-faq-list {
        border-top: 1px solid var(--tp-border-3);
      }
      .tp-faq-item {
        border-bottom: 1px solid var(--tp-border-3);
      }
      .tp-faq-item summary {
        display: grid;
        grid-template-columns: 1fr 36px;
        align-items: center;
        gap: 12px;
        padding: 26px 0;
        cursor: pointer;
        list-style: none;
      }
      .tp-faq-item summary::-webkit-details-marker {
        display: none;
      }
      .tp-faq-q {
        font-family: var(--tp-font-display);
        font-size: clamp(18px, 1.7vw, 22px);
        font-weight: 500;
        letter-spacing: -0.02em;
      }
      .tp-faq-icon {
        position: relative;
        width: 36px;
        height: 36px;
        border-radius: var(--tp-radius);
        background: var(--tp-bg-2);
        border: 1px solid var(--tp-border);
        transition:
          background 0.2s,
          border-color 0.2s;
      }
      .tp-faq-icon::before,
      .tp-faq-icon::after {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        width: 12px;
        height: 1.5px;
        margin: -0.75px 0 0 -6px;
        background: var(--tp-ink);
        transition:
          transform 0.3s var(--tp-ease),
          background 0.2s;
      }
      .tp-faq-icon::after {
        transform: rotate(90deg);
      }
      .tp-faq-item[open] .tp-faq-icon {
        background: var(--tp-ink);
        border-color: var(--tp-ink);
      }
      .tp-faq-item[open] .tp-faq-icon::before,
      .tp-faq-item[open] .tp-faq-icon::after {
        background: var(--tp-bg);
      }
      .tp-faq-item[open] .tp-faq-icon::after {
        transform: rotate(0deg);
      }
      .tp-faq-a {
        padding: 0 48px 30px 0;
        font-size: 15.5px;
        line-height: 1.7;
        color: var(--tp-ink-2);
        max-width: 64ch;
      }
      .tp-faq-a a {
        color: var(--tp-ink);
        text-underline-offset: 3px;
      }

      /* ─── CTA ─── */
      .tp-cta {
        position: relative;
        padding: 168px 0 176px;
        border-top: 1px solid var(--tp-border);
        overflow: hidden;
      }
      .tp-cta .tp-forge {
        -webkit-mask-image: linear-gradient(to right, transparent 30%, #000 85%);
        mask-image: linear-gradient(to right, transparent 30%, #000 85%);
      }
      .tp-cta-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .tp-cta-h2 {
        font-family: var(--tp-font-display);
        font-size: clamp(34px, 5.4vw, 76px);
        line-height: 1;
        letter-spacing: -0.045em;
        font-weight: 500;
        max-width: 17ch;
        text-wrap: balance;
      }
      .tp-cta-sub {
        font-size: 18px;
        color: var(--tp-ink-2);
        margin: 26px 0 36px;
        max-width: 44ch;
      }
      .tp-cta-alt {
        margin-top: 20px;
        font-family: var(--tp-font-mono);
        font-size: 12px;
        color: var(--tp-ink-3);
      }
      .tp-cta-link {
        color: var(--tp-ink-2);
        text-underline-offset: 3px;
      }

      /* ─── Footer ─── */
      .tp-footer {
        position: relative;
        background: var(--tp-bg);
        border-top: 1px solid var(--tp-border);
        padding: 56px 0 0;
        overflow: hidden;
      }
      .tp-footer-top {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
        gap: 40px;
        align-items: flex-start;
      }
      .tp-footer-brand {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }
      .tp-footer-desc {
        font-size: 13px;
        color: var(--tp-ink-3);
        max-width: 240px;
        line-height: 1.55;
      }
      .tp-footer-col {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .tp-footer-col h4 {
        font-size: 13px;
        font-weight: 600;
        color: var(--tp-ink-4);
        margin-bottom: 4px;
      }
      .tp-footer-col a {
        font-size: 13.5px;
        color: var(--tp-ink-2);
        text-decoration: none;
        transition: color 0.15s;
      }
      .tp-footer-col a:hover {
        color: var(--tp-ink);
      }
      .tp-footer-bottom {
        margin-top: 48px;
        padding-top: 20px;
        border-top: 1px solid var(--tp-border);
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: var(--tp-ink-4);
      }
      .tp-footer-meta {
        font-family: var(--tp-font-mono);
      }
      /* The name, set large and quiet */
      .tp-footer-word {
        font-family: var(--tp-font-display);
        font-weight: 600;
        font-size: 25.5vw;
        line-height: 0.74;
        letter-spacing: -0.06em;
        text-align: center;
        white-space: nowrap;
        margin: 56px 0 -0.06em;
        user-select: none;
        color: var(--tp-border);
      }

      /* ─── Responsive ─── */
      @media (max-width: 1000px) {
        .tp-container {
          padding: 0 24px;
        }
        .tp-forge-hint {
          right: 24px;
        }
        .tp-hero-foot {
          flex-direction: column;
          align-items: flex-start;
          gap: 28px;
        }
        .tp-hero-req {
          text-align: left;
        }
        .tp-section-head-row {
          flex-direction: column;
          align-items: flex-start;
          gap: 24px;
        }
        .tp-stage {
          grid-template-columns: minmax(0, 1fr);
          gap: 40px;
        }
        .tp-pain-grid {
          grid-template-columns: 1fr;
        }
        .tp-pain-cell,
        .tp-pain-cell:nth-child(even) {
          padding: 32px 0 36px;
          border-left: none;
        }
        .tp-tool-meta {
          grid-template-columns: 1fr;
          gap: 24px;
        }
        .tp-faq-grid {
          grid-template-columns: 1fr;
          gap: 40px;
        }
        .tp-faq .tp-section-head {
          position: static;
        }
        .tp-footer-top {
          grid-template-columns: 1fr 1fr;
        }
        .tp-footer-brand {
          grid-column: 1 / -1;
        }
        /* Keep the feature column readable while the table scrolls */
        .tp-table .tp-table-feature {
          position: sticky;
          left: 0;
          z-index: 1;
          background: var(--tp-surface);
          box-shadow: 1px 0 0 var(--tp-border-2);
        }
        .tp-table-head .tp-table-feature {
          background: var(--tp-bg-2);
          box-shadow: 1px 0 0 var(--tp-border);
        }
      }

      @media (max-width: 640px) {
        /* Collapse the nav into a hamburger dropdown under the sticky header */
        .tp-nav-toggle {
          display: flex;
        }
        .tp-nav {
          display: none;
          position: absolute;
          top: 64px;
          left: 0;
          right: 0;
          flex-direction: column;
          gap: 0;
          background: var(--tp-bg);
          border-bottom: 1px solid var(--tp-border);
          padding: 4px 24px 8px;
          box-shadow: 0 24px 32px -28px rgba(11, 16, 32, 0.25);
        }
        .tp-nav-open .tp-nav {
          display: flex;
        }
        .tp-nav a {
          padding: 12px 0;
          font-size: 15px;
        }
        .tp-container {
          padding: 0 16px;
        }
        .tp-hero {
          padding-top: 56px;
          min-height: 0;
          padding-bottom: 120px;
        }
        /* Let the headline flow as one sentence instead of two set lines */
        .tp-h1-line {
          display: inline;
        }
        .tp-h1-indent {
          padding-left: 0;
        }
        .tp-copy-cmd {
          flex: 1;
          text-align: left;
        }
        /* Device first, so the taps and the lines that cause them share a screen */
        .tp-device {
          order: -1;
        }
        .tp-hero-h1 {
          margin: 0 0 28px;
        }
        .tp-hero-lead {
          font-size: 17px;
        }
        .tp-hero-ctas {
          width: 100%;
        }
        .tp-hero-ctas .tp-btn-solid,
        .tp-hero-ctas .tp-copy {
          width: 100%;
          justify-content: space-between;
        }
        .tp-hero-ctas .tp-btn-solid {
          justify-content: center;
        }
        .tp-forge-hint {
          right: 16px;
          bottom: 20px;
        }
        .tp-manifesto {
          padding: 96px 0 104px;
        }
        .tp-run,
        .tp-pain,
        .tp-snippets,
        .tp-demo,
        .tp-compare,
        .tp-faq {
          padding-bottom: 104px;
        }
        .tp-tools {
          padding-bottom: 64px;
        }
        .tp-section-head {
          margin-bottom: 36px;
        }
        .tp-section-lead,
        .tp-tool-body {
          font-size: 16px;
        }
        .tp-demo-code {
          font-size: 12px;
          line-height: 1.8;
        }
        .tp-demo-code .line::before {
          width: 34px;
          padding-right: 12px;
        }
        .tp-term-body {
          font-size: 11.5px;
          padding: 14px 16px 18px;
        }
        .tp-phone {
          width: 236px;
          border-radius: 42px;
          padding: 8px;
        }
        .tp-phone-screen {
          border-radius: 34px;
        }
        .tp-app-photo svg {
          width: 96px;
          height: 96px;
        }
        .tp-snippet-panel {
          padding: 20px 18px;
        }
        .tp-snippet-code {
          font-size: 13px;
        }
        .tp-table-wrap {
          margin: 0 -16px;
          padding: 0 16px;
        }
        .tp-table {
          min-width: 580px;
        }
        .tp-table-head .tp-table-feature,
        .tp-table-head .tp-table-col,
        .tp-table-row .tp-table-feature,
        .tp-table-row .tp-table-col {
          padding: 12px 14px;
        }
        .tp-table-row .tp-table-feature {
          font-size: 13px;
        }
        .tp-faq-item summary {
          padding: 20px 0;
        }
        .tp-faq-a {
          padding: 0 0 24px;
        }
        .tp-cta {
          padding: 104px 0 112px;
        }
        .tp-cta-sub {
          font-size: 16px;
        }
        .tp-footer-top {
          grid-template-columns: 1fr;
        }
        .tp-footer-bottom {
          flex-direction: column;
          gap: 8px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
        .tp-app-spinner,
        .tp-term-caret,
        [data-state='running'] .tp-dot-status {
          animation: none;
        }
        .tp-forge-hint {
          display: none;
        }
        .tp-app,
        .tp-app-btn,
        .tp-app-confirm,
        .tp-app-badge,
        .tp-btn-solid {
          transition: none;
        }
      }
    </style>
  </body>
</html>
