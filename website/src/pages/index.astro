    <script>
      const root = document.documentElement
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      // Scroll-lit manifesto words only dim once this script is running
      root.classList.add('tp-js')

      /* ─── Theme toggle + mobile nav ─── */
      document.querySelectorAll('.tp-theme-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
          root.setAttribute('data-theme', next)
          localStorage.setItem('starlight-theme', next)
        })
      })

      const header = document.querySelector('.tp-header')
      const navToggle = document.querySelector('.tp-nav-toggle')
      if (header && navToggle) {
        const setOpen = (open: boolean) => {
          header.classList.toggle('tp-nav-open', open)
          navToggle.setAttribute('aria-expanded', String(open))
          navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
        }
        navToggle.addEventListener('click', () => {
          setOpen(!header.classList.contains('tp-nav-open'))
        })
        // Close the menu when a nav link is tapped (same-page anchors don't reload)
        header.querySelectorAll('.tp-nav a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false))
        })
      }

      /* ─── Copy the install command ─── */
      document.querySelectorAll<HTMLElement>('.tp-copy').forEach((btn) => {
        const state = btn.querySelector('.tp-copy-state')
        let timer = 0
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? '')
            if (state) state.textContent = 'copied'
            btn.classList.add('tp-copied')
          } catch {
            if (state) state.textContent = 'select + copy'
          }
          window.clearTimeout(timer)
          timer = window.setTimeout(() => {
            if (state) state.textContent = 'copy'
            btn.classList.remove('tp-copied')
          }, 1800)
        })
      })

      /* ─── Tabs (every tablist on the page) ─── */
      document.querySelectorAll('[role="tablist"]').forEach((tablist) => {
        const tabs = Array.from(tablist.querySelectorAll<HTMLElement>('[role="tab"]'))
        const panelOf = (tab: HTMLElement) =>
          document.getElementById(tab.getAttribute('aria-controls') ?? '')

        function activate(tab: HTMLElement, focus: boolean) {
          tabs.forEach((t) => {
            const on = t === tab
            t.classList.toggle('tp-tab-active', on)
            t.setAttribute('aria-selected', String(on))
            t.setAttribute('tabindex', on ? '0' : '-1')
            const panel = panelOf(t)
            if (panel) panel.hidden = !on
          })
          if (focus) tab.focus()
        }

        tabs.forEach((tab, idx) => {
          tab.setAttribute('tabindex', idx === 0 ? '0' : '-1')
          tab.addEventListener('click', () => activate(tab, false))
          tab.addEventListener('keydown', (e) => {
            const last = tabs.length - 1
            const to =
              e.key === 'ArrowRight'
                ? (idx + 1) % tabs.length
                : e.key === 'ArrowLeft'
                  ? (idx + last) % tabs.length
                  : e.key === 'Home'
                    ? 0
                    : e.key === 'End'
                      ? last
                      : -1
            if (to < 0) return
            e.preventDefault()
            activate(tabs[to], true)
          })
        })
      })

      /* ─── Lightbox ─── */
      const lightbox = document.getElementById('tp-lightbox') as HTMLDialogElement | null
      const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.tp-lightbox-img')
      if (lightbox && lightboxImg) {
        document.querySelectorAll('.tp-tool-zoom').forEach((btn) => {
          btn.addEventListener('click', () => {
            const img = btn.querySelector('img')
            if (!img) return
            lightboxImg.src = img.src
            lightboxImg.alt = img.alt
            lightbox.showModal()
          })
        })
        // Close on any click (backdrop or image)
        lightbox.addEventListener('click', () => lightbox.close())
        // Clear the image on close so the next open doesn't flash the old one
        lightbox.addEventListener('close', () => {
          lightboxImg.removeAttribute('src')
          lightboxImg.removeAttribute('alt')
        })
      }

      /* ─── Manifesto: words light up with scroll ─── */
      const manifestoEl = document.querySelector<HTMLElement>('.tp-manifesto-text')
      if (manifestoEl) {
        const words = Array.from(manifestoEl.querySelectorAll('.tp-w'))
        let lit = -1
        const update = () => {
          const rect = manifestoEl.getBoundingClientRect()
          const vh = window.innerHeight
          // 0 as the paragraph's top reaches 82% of the viewport, 1 as its bottom reaches 55%
          const p = (vh * 0.82 - rect.top) / (rect.height + vh * 0.27)
          const next = reducedMotion.matches
            ? words.length
            : Math.round(Math.min(1, Math.max(0, p)) * words.length)
          if (next === lit) return
          lit = next
          words.forEach((w, i) => w.classList.toggle('tp-w-on', i < lit))
        }
        let queued = false
        const onScroll = () => {
          if (queued) return
          queued = true
          requestAnimationFrame(() => {
            queued = false
            update()
          })
        }
        window.addEventListener('scroll', onScroll, { passive: true })
        window.addEventListener('resize', onScroll)
        reducedMotion.addEventListener('change', update)
        update()
      }

      /* ─── The forge: a touch grid where each tap strikes like a hammer ───
         Dots sit on a grid like a digitiser. A strike sends a ring outward; dots
         it passes heat to ember, nudge away from the blow, then cool. */
      type Strike = { x: number; y: number; t0: number; power: number }

      function forge(zone: HTMLElement, canvas: HTMLCanvasElement) {
        const context = canvas.getContext('2d')
        if (!context) return
        const ctx = context
        const GAP = 24
        const LIFE = 2600
        let w = 0
        let h = 0
        let cols = 0
        let rows = 0
        let heat = new Float32Array(0)
        let strikes: Strike[] = []
        let pointerX = -1e4
        let pointerY = -1e4
        let visible = false
        let raf = 0
        let last = 0
        let nextAuto = 0
        let cold = ''
        let hot = ''
        let core = ''

        function readColors() {
          const cs = getComputedStyle(canvas)
          cold = cs.getPropertyValue('--tp-dot').trim() || 'rgba(128,128,128,.2)'
          hot = cs.getPropertyValue('--tp-dot-hot').trim() || '#e8914b'
          core = cs.getPropertyValue('--tp-dot-core').trim() || '#ffd9a8'
        }

        function resize() {
          const rect = canvas.getBoundingClientRect()
          const dpr = Math.min(window.devicePixelRatio || 1, 2)
          w = rect.width
          h = rect.height
          canvas.width = Math.round(w * dpr)
          canvas.height = Math.round(h * dpr)
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          cols = Math.ceil(w / GAP) + 1
          rows = Math.ceil(h / GAP) + 1
          heat = new Float32Array(cols * rows)
        }

        function strike(x: number, y: number, power: number, t0: number) {
          strikes.push({ x, y, t0, power })
          if (strikes.length > 8) strikes.shift()
        }

        function draw(now: number, dt: number) {
          ctx.clearRect(0, 0, w, h)
          strikes = strikes.filter((s) => now - s.t0 < LIFE)
          const decay = Math.exp(-dt / 380)
          const ox = (w % GAP) / 2
          const oy = (h % GAP) / 2

          ctx.fillStyle = cold
          const hotDots: number[] = []
          for (let r = 0; r < rows; r++) {
            for (let c = 0; c < cols; c++) {
              const i = r * cols + c
              const x = ox + c * GAP
              const y = oy + r * GAP
              let v = heat[i] * decay
              let pushX = 0
              let pushY = 0
              for (const s of strikes) {
                const age = now - s.t0
                const dx = x - s.x
                const dy = y - s.y
                const d = Math.sqrt(dx * dx + dy * dy) || 1
                const ring = age * 0.4
                const band = 22 + age * 0.012
                const k = Math.exp(-(((d - ring) / band) ** 2)) * s.power * (1 - age / LIFE) ** 1.5
                if (k > v) v = k
                pushX += (dx / d) * k * 5
                pushY += (dy / d) * k * 5
              }
              const pdx = x - pointerX
              const pdy = y - pointerY
              const pd = pdx * pdx + pdy * pdy
              if (pd < 14400) {
                const k = (1 - Math.sqrt(pd) / 120) * 0.5
                if (k > v) v = k
              }
              heat[i] = v
              if (v < 0.03) {
                ctx.fillRect(x - 1, y - 1, 2, 2)
              } else {
                hotDots.push(x + pushX, y + pushY, v)
              }
            }
          }

          for (let i = 0; i < hotDots.length; i += 3) {
            const v = Math.min(1, hotDots[i + 2])
            ctx.globalAlpha = 0.25 + v * 0.75
            ctx.fillStyle = v > 0.72 ? core : hot
            ctx.beginPath()
            ctx.arc(hotDots[i], hotDots[i + 1], 1 + v * 2.1, 0, Math.PI * 2)
            ctx.fill()
          }

          // The tap itself: a touch point and a thin ring, as the trace viewer draws one
          ctx.strokeStyle = hot
          ctx.fillStyle = hot
          ctx.lineWidth = 1.25
          for (const s of strikes) {
            const age = now - s.t0
            if (age > 900) continue
            const t = age / 900
            ctx.globalAlpha = (1 - t) * 0.7 * s.power
            ctx.beginPath()
            ctx.arc(s.x, s.y, 8 + t * 46, 0, Math.PI * 2)
            ctx.stroke()
            if (age < 320) {
              ctx.globalAlpha = (1 - age / 320) * 0.85
              ctx.beginPath()
              ctx.arc(s.x, s.y, 7, 0, Math.PI * 2)
              ctx.fill()
            }
          }
          ctx.globalAlpha = 1
        }

        function frame(now: number) {
          raf = 0
          if (!visible) return
          const dt = Math.min(64, now - (last || now))
          last = now
          if (now > nextAuto) {
            strike(
              w * (0.08 + Math.random() * 0.84),
              h *
                (zone.classList.contains('tp-hero')
                  ? 0.7 + Math.random() * 0.26
                  : 0.1 + Math.random() * 0.8),
              0.75 + Math.random() * 0.25,
              now,
            )
            nextAuto = now + 1100 + Math.random() * 1500
          }
          draw(now, dt)
          raf = requestAnimationFrame(frame)
        }

        // Reduced motion: one still frame, mid-strike
        function still() {
          heat.fill(0)
          strikes = [
            { x: w * 0.78, y: h * 0.7, t0: -520, power: 1 },
            { x: w * 0.3, y: h * 0.82, t0: -900, power: 0.85 },
          ]
          draw(0, 16)
        }

        function start() {
          if (reducedMotion.matches) {
            cancelAnimationFrame(raf)
            raf = 0
            still()
            return
          }
          if (visible && !raf) {
            last = 0
            raf = requestAnimationFrame(frame)
          }
        }

        const local = (e: PointerEvent) => {
          const rect = canvas.getBoundingClientRect()
          return { x: e.clientX - rect.left, y: e.clientY - rect.top }
        }
        zone.addEventListener('pointermove', (e) => {
          const p = local(e)
          pointerX = p.x
          pointerY = p.y
        })
        zone.addEventListener('pointerleave', () => {
          pointerX = pointerY = -1e4
        })
        zone.addEventListener('pointerdown', (e) => {
          if (reducedMotion.matches) return
          const p = local(e)
          strike(p.x, p.y, 1, performance.now())
          nextAuto = performance.now() + 2200
        })

        new IntersectionObserver((entries) => {
          visible = entries[0].isIntersecting
          start()
        }).observe(canvas)
        new ResizeObserver(() => {
          resize()
          start()
        }).observe(canvas)
        new MutationObserver(() => {
          readColors()
          start()
        }).observe(root, { attributes: true, attributeFilter: ['data-theme'] })
        reducedMotion.addEventListener('change', start)

        readColors()
        resize()
      }

      document.querySelectorAll<HTMLElement>('[data-forge-zone]').forEach((zone) => {
        const canvas = zone.querySelector('canvas')
        if (canvas) forge(zone, canvas)
      })

      /* ─── Live demo: the code, the device and the terminal run in step ─── */
      const demo = document.querySelector<HTMLElement>('[data-demo]')
      if (demo) {
        const phone = demo.querySelector<HTMLElement>('.tp-phone')
        const screen = demo.querySelector<HTMLElement>('.tp-phone-screen')
        const tapEl = demo.querySelector<HTMLElement>('.tp-tap')
        const probe = demo.querySelector<HTMLElement>('.tp-probe')
        const status = demo.querySelector<HTMLElement>('[data-demo-status]')
        const statusText = demo.querySelector<HTMLElement>('[data-demo-status-text]')
        const typed = demo.querySelector<HTMLElement>('[data-term-typed]')
        const lines = Array.from(demo.querySelectorAll<HTMLElement>('.tp-demo-code .line'))
        const term = (name: string) => demo.querySelector<HTMLElement>(`[data-term="${name}"]`)
        const command = typed?.textContent ?? ''
        let run = 0
        let inView = false

        class Cancelled extends Error {}
        const sleep = (ms: number, id: number) =>
          new Promise<void>((resolve, reject) => {
            window.setTimeout(() => (id === run ? resolve() : reject(new Cancelled())), ms)
          })

        const setStep = (n: number) => phone?.setAttribute('data-step', String(n))
        const setStatus = (state: string, text: string) => {
          status?.setAttribute('data-state', state)
          if (statusText) statusText.textContent = text
        }
        // 1-based line numbers, as the editor shows them
        const mark = (active: number[], done: number[]) => {
          lines.forEach((line, i) => {
            line.classList.toggle('tp-line-run', active.includes(i + 1))
            line.classList.toggle('tp-line-done', done.includes(i + 1))
          })
        }
        const centreOf = (target: string) => {
          const el = demo.querySelector<HTMLElement>(`[data-target="${target}"]`)
          if (!el || !screen) return null
          const a = el.getBoundingClientRect()
          const b = screen.getBoundingClientRect()
          return { x: a.left - b.left, y: a.top - b.top, w: a.width, h: a.height }
        }
        const tap = (target: string) => {
          const box = centreOf(target)
          if (!box || !tapEl) return
          tapEl.style.left = `${box.x + box.w / 2}px`
          tapEl.style.top = `${box.y + box.h / 2}px`
          tapEl.classList.remove('tp-tap-go')
          void tapEl.offsetWidth
          tapEl.classList.add('tp-tap-go')
        }
        const placeProbe = () => {
          const box = centreOf('confirmed')
          if (!box || !probe) return
          probe.style.left = `${box.x - 6}px`
          probe.style.top = `${box.y - 4}px`
          probe.style.width = `${box.w + 12}px`
          probe.style.height = `${box.h + 8}px`
        }
        const showTerm = (names: string[]) => {
          ;['cmd', 'start', 'pass', 'summary'].forEach((name) => {
            term(name)?.classList.toggle('tp-term-show', names.includes(name))
          })
        }

        function finished() {
          setStep(5)
          mark([], [5, 6, 7, 9, 10, 12])
          if (typed) typed.textContent = command
          demo?.classList.remove('tp-typing')
          showTerm(['cmd', 'start', 'pass', 'summary'])
          setStatus('passed', 'passed · 1.4s')
          placeProbe()
        }

        async function play() {
          const id = ++run
          try {
            setStep(0)
            mark([], [])
            showTerm(['cmd'])
            setStatus('idle', 'ready')
            demo?.classList.add('tp-typing')
            if (typed) typed.textContent = ''
            await sleep(500, id)
            for (let i = 1; i <= command.length; i++) {
              if (typed) typed.textContent = command.slice(0, i)
              await sleep(38 + Math.random() * 40, id)
            }
            await sleep(350, id)
            demo?.classList.remove('tp-typing')
            showTerm(['cmd', 'start'])
            setStatus('running', 'running')
            await sleep(700, id)

            mark([5, 6, 7], [])
            setStep(1)
            await sleep(1500, id)

            mark([9], [5, 6, 7])
            tap('add')
            await sleep(380, id)
            setStep(2)
            await sleep(1400, id)

            mark([10], [5, 6, 7, 9])
            tap('checkout')
            await sleep(380, id)
            setStep(3)
            await sleep(1100, id)
            setStep(4)
            await sleep(500, id)

            mark([12], [5, 6, 7, 9, 10])
            placeProbe()
            setStep(5)
            await sleep(1300, id)

            mark([], [5, 6, 7, 9, 10, 12])
            setStatus('passed', 'passed · 1.4s')
            showTerm(['cmd', 'start', 'pass'])
            await sleep(450, id)
            showTerm(['cmd', 'start', 'pass', 'summary'])
            await sleep(5200, id)
            if (inView) void play()
          } catch (err) {
            if (!(err instanceof Cancelled)) throw err
          }
        }

        const begin = () => {
          if (reducedMotion.matches) {
            run++
            finished()
          } else if (inView) {
            void play()
          }
        }

        demo.querySelector('[data-demo-replay]')?.addEventListener('click', () => {
          if (!reducedMotion.matches) void play()
        })
        new IntersectionObserver(
          (entries) => {
            const now = entries[0].isIntersecting
            if (now === inView) return
            inView = now
            if (inView) begin()
            else {
              // Off screen: stop where it is and rest on the finished frame
              run++
              finished()
            }
          },
          { threshold: 0.35 },
        ).observe(demo)
        reducedMotion.addEventListener('change', begin)
        window.addEventListener('resize', placeProbe)
        finished()
      }
    </script>

