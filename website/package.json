{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-releases": "node scripts/sync-releases.mjs",
    "sync": "npm run sync-docs && npm run sync-releases && npm run sync-promo",
    "dev": "npm run sync && astro dev",
    "start": "npm run sync && astro dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip",
    "astro": "astro",
    "sync-promo": "node scripts/sync-promo.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.39.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.0.0",
    "sharp": "^0.35.0",
    "starlight-image-zoom": "^0.14.2",
    "starlight-links-validator": "^0.24.0",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "$vite"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "eslint": "^10.4.0",
    "github-slugger": "^2.0.0",
    "knip": "^6.14.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.3"
  }
}
