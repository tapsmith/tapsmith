{
  "name": "@tapsmith/react-native",
  "version": "0.5.0",
  "description": "In-app reset hooks for Tapsmith — sub-second, acknowledged app resets in React Native / Expo test builds",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "homepage": "https://tapsmith.dev",
  "bugs": {
    "url": "https://github.com/tapsmith/tapsmith/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tapsmith/tapsmith.git",
    "directory": "packages/tapsmith-react-native"
  },
  "author": "Sam Smith <sam@sammysmith.co.uk>",
  "keywords": [
    "tapsmith",
    "react-native",
    "expo",
    "testing",
    "e2e"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "react-native": "^0.79.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
