{
  "name": "tapsmith",
  "version": "0.5.0",
  "description": "Mobile app testing framework — TypeScript SDK and test runner",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tapsmith": "dist/cli.js"
  },
  "scripts": {
    "build": "npm run clean && tsc && chmod +x dist/cli.js && mkdir -p dist/proto && cp ../../proto/tapsmith.proto dist/proto/ && mkdir -p dist/schema && cp schema/trace-format.schema.json dist/schema/ && npm run build:ios-agent-src && npm run build:trace-viewer && npm run build:ui-mode",
    "build:ios-agent-src": "(mkdir -p dist/ios-agent; [ -d ../../ios-agent/TapsmithAgent ] && cp -r ../../ios-agent/TapsmithAgent dist/ios-agent/; [ -d ../../ios-agent/TapsmithAgent.xcodeproj ] && cp -r ../../ios-agent/TapsmithAgent.xcodeproj dist/ios-agent/; [ -f ../../ios-agent/create-xcode-project.sh ] && cp ../../ios-agent/create-xcode-project.sh dist/ios-agent/; [ -f ../../ios-agent/Package.swift ] && cp ../../ios-agent/Package.swift dist/ios-agent/) || true",
    "clean": "rm -rf dist",
    "build:trace-viewer": "vite build",
    "build:ui-mode": "vite build --config vite.config.ui-mode.ts",
    "dev:ui-mode": "vite --config vite.config.ui-mode.ts",
    "fetch-bezels": "node scripts/fetch-bezels.mjs",
    "lint": "eslint src/",
    "knip": "knip",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.apps.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/"
  ],
  "homepage": "https://tapsmith.dev",
  "bugs": {
    "url": "https://github.com/tapsmith/tapsmith/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tapsmith/tapsmith.git"
  },
  "author": "Sam Smith <sam@sammysmith.co.uk>",
  "keywords": [
    "mobile",
    "testing",
    "android",
    "ios",
    "automation",
    "ui-testing"
  ],
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./trace-format.schema.json": "./dist/schema/trace-format.schema.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bplist-creator": "^0.1.1",
    "bplist-parser": "^0.3.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "fflate": "^0.8.2",
    "figlet": "^1.11.0",
    "glob": "^11.0.0",
    "minimatch": "^10.2.4",
    "open": "^10.2.0",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.23.15",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prefresh/vite": "^2.4.12",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "knip": "^5.86.0",
    "lucide-preact": "^1.6.0",
    "preact": "^10.29.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.2",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@tapsmith/agent-android": "*",
    "@tapsmith/agent-ios-simulator-arm64": "*",
    "@tapsmith/agent-ios-simulator-x64": "*",
    "@tapsmith/core-darwin-arm64": "*",
    "@tapsmith/core-darwin-x64": "*",
    "@tapsmith/core-linux-arm64": "*",
    "@tapsmith/core-linux-x64": "*"
  },
  "engines": {
    "node": ">=22"
  }
}
