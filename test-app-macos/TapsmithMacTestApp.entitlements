<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed like most Mac apps (all Mac App Store apps): its data lives in
	     ~/Library/Containers/dev.tapsmith.mactestapp, which the e2e suite clears. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
